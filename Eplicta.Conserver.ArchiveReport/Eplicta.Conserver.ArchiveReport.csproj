<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>

		<PackageId>MetsDataCompiler</PackageId>
		<Version>1.0.0</Version>

		<Title>EplicaMetsPackage</Title>
		<Authors>Malte Mohr, Max Robinson, Eylul Uzel</Authors>
		<Company>Eplica</Company>

		<Description>Creates an excel file with metadata retrieved from a package with a METS file inside</Description>

		<PackageTags>METS excel metadata conserver</PackageTags>

		<PackageProjectUrl>https://github.com/Eplica/ArchiveReport</PackageProjectUrl>
		<RepositoryUrl>https://github.com/Eplica/ArchiveReport</RepositoryUrl>
		<RepositoryType>git</RepositoryType>

		<PackageLicenseExpression>MIT</PackageLicenseExpression>

		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
	</PropertyGroup>

	<ItemGroup>
		<EmbeddedResource Include="Templates\mall_webb_2026.xlsx" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Eplicta.Mets" Version="1.3.63" />
		<PackageReference Include="EPPlus" Version="8.4.2" />
		<PackageReference Include="taglib-sharp-netstandard2.0" Version="2.1.0" />
	</ItemGroup>

</Project>
