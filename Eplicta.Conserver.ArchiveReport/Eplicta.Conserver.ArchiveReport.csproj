<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0;net11.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>

		<PackageId>Eplicta.ArchiveReport</PackageId>
		<Version>1.2.0</Version>

		<Title>Eplicta.ArchiveReport</Title>
		<Authors>Arthur Brobäck, Malte Mohr, Max Robinson, Eylul Uzel</Authors>
		<Company>Eplicta</Company>

		<Description>Creates an Excel metadata appendix (Riksarkivet "Metadatabilaga") from archive delivery metadata and a file list.</Description>

		<PackageTags>excel metadata conserver riksarkivet metadatabilaga</PackageTags>

		<PackageProjectUrl>https://github.com/Eplicta/ArchiveReport</PackageProjectUrl>
		<RepositoryUrl>https://github.com/Eplicta/ArchiveReport</RepositoryUrl>
		<RepositoryType>git</RepositoryType>

		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageIcon>icon.png</PackageIcon>

		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>

	</PropertyGroup>

	<ItemGroup>
		<EmbeddedResource Include="Templates\mall_webb_2026.xlsx" />
		<None Include="..\README.md" Pack="true" PackagePath="\" />
		<None Include="icon.png" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="ClosedXML" Version="0.105.1" />
	</ItemGroup>

</Project>
