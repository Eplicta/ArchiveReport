<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>$(MetsDataCompiler)</PackageId>
    <Title>EplictaMetsPackager</Title>
    <Authors>$(Malte Mohr, Max Rubbinson, Eylul Uzel)</Authors>
    <Company>$(Eplicta)</Company>
    <Description>Creates a excel file with meta data retrived from a package with a mets file inside</Description>
    <PackageProjectUrl>https://github.com/Eplicta/ArchiveReport</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Eplicta/ArchiveReport</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Templates\mall_webb_2026.xlsx" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Eplicta.Mets" Version="1.3.63" />
    <PackageReference Include="EPPlus" Version="8.4.2" />
    <PackageReference Include="taglib-sharp-netstandard2.0" Version="2.1.0" />
  </ItemGroup>

</Project>
